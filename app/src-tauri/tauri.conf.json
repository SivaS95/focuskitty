{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusKitty",
  "version": "0.1.1",
  "identifier": "com.siva.focuskitty",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "cat",
        "url": "cat.html",
        "title": "FocusKitty",
        "width": 340,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "hiddenTitle": true
      },
      {
        "label": "popover",
        "url": "popover.html",
        "title": "FocusKitty",
        "width": 300,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "FocusKitty",
        "width": 940,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
